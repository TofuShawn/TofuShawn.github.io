{
  "name": "paper-dossier",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "A multi-skin blog template that behaves like a printed object. Ship one skin, swap in another.",
  "scripts": {
    "dev": "node scripts/scope-skins.mjs && astro dev",
    "build": "node scripts/scope-skins.mjs && astro build",
    "preview": "astro preview",
    "check": "node scripts/check.mjs",
    "new": "node scripts/new-post.mjs",
    "verify": "npm run build && node scripts/verify.mjs",
    "verify:docker": "node scripts/verify-docker.mjs",
    "test:verify": "node scripts/test-verify-docker.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "astro": "^7.4.5",
    "zod": "^4.6.7"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TofuShawn/paper-dossier.git"
  },
  "homepage": "https://github.com/TofuShawn/paper-dossier#readme",
  "bugs": {
    "url": "https://github.com/TofuShawn/paper-dossier/issues"
  },
  "keywords": [
    "astro",
    "blog",
    "template",
    "skins",
    "design-system",
    "print",
    "typography",
    "static-site"
  ]
}

---
/** The archive: every entry, grouped by year. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import RunningHead from '../../components/RunningHead.astro';
import Folio from '../../components/Folio.astro';
import CropMarks from '../../components/CropMarks.astro';
import IndexRow from '../../components/IndexRow.astro';
import { POSTS, groupByYear, getTags } from '../../lib/posts';
import { SITE } from '../../lib/site';
import { featuresAny } from '../../skins/registry';

const f = featuresAny();
const groups = groupByYear(POSTS);
const tags = getTags();
---

<BaseLayout title="Index" path="/posts/">
  <div class="sheet">
    <section class="spread">
      {f.printArtifacts && <CropMarks corners={2} />}
      <RunningHead no="02" title="Index" en={`${POSTS.length} entries`} />

      <div class="g">
        <div class="c1-7">
          <h1 class="t-display" data-rev>Every entry</h1>
          <p class="t-lead" style="margin-top:14px;--d:80ms" data-rev>
            按时间倒序。每一条都有编号、日期与阅读时长。
          </p>

          {
            groups.map((g) => (
              <div class="stag-group">
                <p class="ix-year">{g.year}</p>
                {g.posts.map((p) => (
                  <IndexRow post={p} mark={`${p.displayCode}`} />
                ))}
              </div>
            ))
          }
        </div>

        <div class="c9-12">
          <div class="sidenote">
            <p><b>Index</b> {POSTS.length} entries across {groups.length} years.</p>
          </div>

          <div style="margin-top:26px">
            <p class="t-micro" style="border-bottom:1px solid var(--fg);padding-bottom:8px">
              Tags
            </p>
            <div class="tag-cloud" style="margin-top:12px">
              {tags.map((t) => (
                <a class="tag" href={`/tags/${t.tag.toLowerCase().replace(/\s+/g, '-')}/`}>
                  {t.tag}
                  <span class="n">{String(t.count).padStart(2, '0')}</span>
                </a>
              ))}
            </div>
          </div>

          <p style="margin-top:26px">
            <a href="/rss.xml" class="t-cap" style="color:var(--accent-text);text-decoration:none">
              → RSS feed
            </a>
          </p>
        </div>
      </div>

      <Folio page="P.02" note="INDEX" />
    </section>
  </div>
</BaseLayout>
